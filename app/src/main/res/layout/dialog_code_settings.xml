<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_theme"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_code_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/text_code_font_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="14 sp"
            android:textSize="13sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seek_code_font_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/check_code_line_numbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editor_line_numbers" />

        <CheckBox
            android:id="@+id/check_code_current_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editor_current_line" />

        <CheckBox
            android:id="@+id/check_code_word_wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editor_word_wrap" />

        <CheckBox
            android:id="@+id/check_code_auto_indent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editor_auto_indent" />

        <CheckBox
            android:id="@+id/check_code_highlighting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editor_highlighting" />

        <CheckBox
            android:id="@+id/check_code_completion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editor_completion" />

        <CheckBox
            android:id="@+id/check_code_bracket_matching"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editor_bracket_matching" />

        <CheckBox
            android:id="@+id/check_code_auto_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editor_auto_save" />

    </LinearLayout>
</ScrollView>
