<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_navigation_designer"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:title="@string/flow_navigation_title" />

    <com.nobi.appbuilder.ui.flow.NavigationGraphView
        android:id="@+id/graph_navigation_view"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="#F5F5F5" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_nav_edges"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btn_nav_add_edge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/flow_nav_add_edge" />

        <Button
            android:id="@+id/btn_nav_validate"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/flow_validate" />

        <Button
            android:id="@+id/btn_nav_rebuild"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/flow_nav_rebuild" />
    </LinearLayout>

</LinearLayout>
