<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="?attr/colorPrimary"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/text_code_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/editor_title"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btn_code_save"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/editor_save"
        android:src="@drawable/ic_save" />

    <ImageButton
        android:id="@+id/btn_code_undo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/editor_undo"
        android:src="@drawable/ic_undo" />

    <ImageButton
        android:id="@+id/btn_code_redo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/editor_redo"
        android:src="@drawable/ic_redo" />

    <ImageButton
        android:id="@+id/btn_code_format"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/editor_format"
        android:src="@drawable/ic_code" />

    <ImageButton
        android:id="@+id/btn_code_search"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/editor_find"
        android:src="@drawable/ic_search" />

    <ImageButton
        android:id="@+id/btn_code_explorer"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/editor_files"
        android:src="@drawable/ic_folder" />

    <ImageButton
        android:id="@+id/btn_code_settings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/editor_settings"
        android:src="@drawable/ic_settings" />

</LinearLayout>
