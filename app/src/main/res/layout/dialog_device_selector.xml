<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <RadioGroup
        android:id="@+id/group_devices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/radio_compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Compact phone" />

        <RadioButton
            android:id="@+id/radio_standard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Standard phone" />

        <RadioButton
            android:id="@+id/radio_large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Large phone" />

        <RadioButton
            android:id="@+id/radio_tablet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Small tablet" />

        <RadioButton
            android:id="@+id/radio_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/device_custom" />

    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input_custom_width"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/device_custom_width"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="×" />

        <EditText
            android:id="@+id/input_custom_height"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/device_custom_height"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:text="dp" />

    </LinearLayout>

    <CheckBox
        android:id="@+id/check_show_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/preview_show_frame" />

</LinearLayout>
