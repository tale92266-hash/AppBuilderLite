<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/image_hierarchy_arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/hierarchy_expand"
        android:src="@drawable/ic_chevron_right" />

    <TextView
        android:id="@+id/text_hierarchy_thumb"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_component_thumb"
        android:gravity="center"
        android:text="T"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_hierarchy_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp" />

    <ImageButton
        android:id="@+id/button_hierarchy_eye"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/hierarchy_toggle_visibility"
        android:src="@drawable/ic_visibility" />

    <ImageButton
        android:id="@+id/button_hierarchy_lock"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/hierarchy_toggle_lock"
        android:src="@drawable/ic_lock_open" />

</LinearLayout>
