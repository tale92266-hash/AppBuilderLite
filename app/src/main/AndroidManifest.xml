<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 15 cloud build: the app talks to the GitHub API to
         upload the project ZIP, trigger the build and download the
         APK. No other network use exists in the app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppBuilderLite">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false"
            android:label="@string/dashboard_title" />

        <activity
            android:name=".ui.editor.EditorActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.preview.PreviewActivity"
            android:exported="false"
            android:label="@string/action_preview"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.code.CodeStudioActivity"
            android:exported="false"
            android:label="@string/code_studio_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.export.ExportActivity"
            android:exported="false"
            android:label="@string/export_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.build.BuildActivity"
            android:exported="false"
            android:label="@string/build_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.codeeditor.CodeEditorActivity"
            android:exported="false"
            android:label="@string/editor_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.library.ComponentLibraryActivity"
            android:exported="false"
            android:label="@string/library_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.library.CustomComponentEditorActivity"
            android:exported="false"
            android:label="@string/library_custom_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.library.TemplateGalleryActivity"
            android:exported="false"
            android:label="@string/library_templates_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.library.TemplateEditorActivity"
            android:exported="false"
            android:label="@string/library_template_edit_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.library.DesignSystemActivity"
            android:exported="false"
            android:label="@string/library_design_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.assets.AssetManagerActivity"
            android:exported="false"
            android:label="@string/asset_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.assets.ImageEditorActivity"
            android:exported="false"
            android:label="@string/asset_image_editor_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.assets.DrawableEditorActivity"
            android:exported="false"
            android:label="@string/asset_drawable_editor_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.assets.VectorEditorActivity"
            android:exported="false"
            android:label="@string/asset_vector_editor_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.assets.FontManagerActivity"
            android:exported="false"
            android:label="@string/asset_fonts_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.assets.ColorResourceActivity"
            android:exported="false"
            android:label="@string/asset_colors_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.flow.NavigationDesignerActivity"
            android:exported="false"
            android:label="@string/flow_navigation_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.flow.FlowEditorActivity"
            android:exported="false"
            android:label="@string/flow_editor_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.flow.EventEditorActivity"
            android:exported="false"
            android:label="@string/flow_event_editor_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.flow.TransitionEditorActivity"
            android:exported="false"
            android:label="@string/flow_transition_title"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.nobi.appbuilder.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
